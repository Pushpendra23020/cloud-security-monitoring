POSTGRES_DB=cloud_security
POSTGRES_USER=security_admin
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=db
POSTGRES_PORT=5432
# The Docker database bootstrap creates this restricted NOLOGIN role and grants
# it to POSTGRES_USER. Application connections drop privileges with SET ROLE.
DATABASE_RUNTIME_ROLE=cloud_security_runtime
RLS_ENFORCEMENT_REQUIRED=true
# Managed platforms may use a privileged URL only for Alembic migrations.
MIGRATION_DATABASE_URL=

SECRET_KEY=replace_with_at_least_32_random_characters
AUTH_ENABLED=true
AUTH_BOOTSTRAP_ADMIN_USERNAME=admin
AUTH_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
AUTH_BOOTSTRAP_ADMIN_PASSWORD=replace_with_at_least_12_random_characters
# Bootstrap values create the first administrator only. They do not reset an
# existing account; remove the password from the platform after first startup.
ACCESS_TOKEN_EXPIRE_MINUTES=10
AUTH_SESSION_EXPIRE_DAYS=7
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_MINUTES=15
# Use false only for local HTTP development. Hosted production must use true.
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=strict
AUTH_MFA_ENCRYPTION_KEY=replace_with_a_separate_32_character_random_key
AUTH_MFA_ISSUER=Cloud Sentinel
AUTH_MFA_CHALLENGE_MINUTES=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
AUTH_RATE_LIMIT_BLOCK_SECONDS=900
AUTH_RATE_LIMIT_PRINCIPAL_ATTEMPTS=10
AUTH_RATE_LIMIT_IP_ATTEMPTS=50
AUTH_TRUSTED_PROXY_CIDRS=127.0.0.0/8

# Optional enterprise OIDC. Users must be pre-provisioned unless verified-email
# linking is explicitly enabled.
OIDC_ENABLED=false
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_SCOPES=openid email profile
OIDC_ALLOWED_ALGORITHMS=RS256
OIDC_ALLOW_EMAIL_LINKING=false
OIDC_ALLOWED_EMAIL_DOMAINS=

DEBUG=false
AWS_REGION=ap-south-1

ALERT_CONSOLE_NOTIFICATIONS=true
ALERT_WEBHOOK_ENABLED=false
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_ORGANIZATION_ID=1
ALERT_WEBHOOK_TIMEOUT=5.0
ALERT_WEBHOOK_MAX_ATTEMPTS=3
ALERT_WEBHOOK_BACKOFF_SECONDS=1.0
ENVIRONMENT=production
LOG_LEVEL=INFO
METRICS_ENABLED=true
PLATFORM_DIAGNOSTICS_ENABLED=false
EVENT_INGEST_API_KEY=replace_with_a_long_random_ingestion_key
EVENT_QUEUE_BATCH_SIZE=25
EVENT_QUEUE_POLL_SECONDS=2.0
EVENT_QUEUE_MAX_ATTEMPTS=5
EVENT_QUEUE_LOCK_TIMEOUT_SECONDS=300
EVENT_QUEUE_RETRY_BASE_SECONDS=10
EVENT_QUEUE_ALERT_AGE_SECONDS=300
EVENT_DATABASE_RETENTION_DAYS=30
EVENT_RETENTION_CLEANUP_INTERVAL_SECONDS=3600
EVENT_RETENTION_CLEANUP_BATCH_SIZE=500
EVENT_ARCHIVE_PROVIDER=filesystem
EVENT_ARCHIVE_RETENTION_DAYS=365
EVENT_ARCHIVE_S3_BUCKET=
EVENT_ARCHIVE_S3_PREFIX=security-events
EVENT_ARCHIVE_S3_KMS_KEY_ID=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace_with_a_strong_grafana_password
